with Files("**"):
    BUG_COMPONENT = ("Core", "Widget")

with Files("*TextInput*"):
    BUG_COMPONENT = ("Core", "DOM: UI Events & Focus Handling")

EXPORTS += [
    "../cocoa/CFTypeRefPtr.h",
]

EXPORTS.mozilla.widget += [
    "/mobile/ios/GeckoViewAPI/Sources/GeckoViewSupport/include/GeckoViewSupport.h",
    "AndroidView.h",
    "EventDispatcher.h",
    "nsWindow.h",
]

SOURCES += [
    "EventDispatcher.mm",
    "GeckoViewSupportImpl.mm",
    "GfxInfo.cpp",
    "MediaKeysEventSourceFactory.cpp",
    "nsAppShell.mm",
    "nsBidiKeyboard.mm",
    "nsLookAndFeel.mm",
    "nsNativeThemeUIKit.mm",
    "nsUserIdleServiceUIKit.cpp",
    "nsWidgetFactory.mm",
    "nsWindow.mm",
    "ScreenHelperUIKit.mm",
    "TextInputHandler.mm",
    "UIKitUtils.mm",
]

XPIDL_SOURCES += [
    "../android/nsIAndroidBridge.idl",
]

XPIDL_MODULE = "widget_uikit"

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
LOCAL_INCLUDES += [
    "!/build",
    "/mobile/ios/GeckoViewAPI/Sources/GeckoViewSupport/include",
    "/widget",
    "/widget/headless",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework UIKit",
]
